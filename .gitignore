__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/
.venv/
.env
data/geo/

# Refresh machinery: derived inputs are regenerable, so they are not tracked.
# work/schemas/, work/answers/, and work/audit/ ARE tracked -- they are the
# research contract, the cited evidence, and the provenance log.
work/packets/
work/worklist-*.json
work/chronology/
work/chronology-candidates.json
work/sibling-gaps.json

# Archived evidence (work/sources/): manifests and public-record text are tracked; news and
# other private copies are ignored per state by scripts/classify_sources.py (see work/README.md);
# raw PDFs (1.3 GB) and HTML (0.5 GB) stay on disk. Each manifest line carries the body sha256.
work/sources/**/*.html
work/sources/**/*.pdf
work/sources/**/*.png
work/sources/**/*.bin

# Refresh worker raw logs and unclassified provider/source payloads.
work/job-runs/
work/research/**/*.private*
# Worker OCR/conversion helpers may choose ordinary filenames; no raw research
# text, document, image or HTML body is public until imported/classified.
work/research/**/*.txt
work/research/**/*.pdf
work/research/**/*.png
work/research/**/*.html
work/research/**/*.body
work/research/**/*.bin

work/research/2026-11-05/full

work/jobs/2026-11-05-full/

work/jobs/2026-11-05-discovery/
work/jobs/2026-11-05-recovery/

# Combined unreviewed claims and candidate payloads await excerpt/rights review.
# Census manifests and identity/grouping metadata remain public and replayable.
work/research/2026-11-05/ballot-census-review/expanded/
work/research/2026-11-05/ballot-census-review/candidate-dispositions.jsonl

# Stable lock for atomic expanded-table snapshot publication.
data/.expanded.lock

# Private fresh OCR retained for Heath historical source recovery.
work/sources/MA/heath-warrant-recovery-7ef5c4ef9b98.txt
